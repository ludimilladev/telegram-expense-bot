    {
      "parameters": {
        "jsCode": "function paraNumero(v) {\n  if (typeof v === 'number') return v;\n  let s = String(v ?? '').replace('R$', '').trim();\n  if (s.includes(',')) s = s.replace(/\\./g, '').replace(',', '.');\n  const n = Number(s);\n  return Number.isFinite(n) ? n : 0;\n}\n\nconst novo = $('If').first().json.output.valor;\n\n// ignora o item vazio que \"Always Output Data\" cria quando não acha nada\nconst linhas = $input.all().filter(item => Object.keys(item.json).length > 0);\n\nconst totalAnterior = linhas.reduce((soma, item) => {\n  const bruto = item.json.valor ?? item.json.Valor;\n  return soma + paraNumero(bruto);\n}, 0);\n\nconst total = Math.round((totalAnterior + paraNumero(novo)) * 100) / 100;\n\nreturn [{\n  json: {\n    total_mes: total,\n    total_formatado: total.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }),\n    linhas_lidas: linhas.length,\n    total_anterior: totalAnterior,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
