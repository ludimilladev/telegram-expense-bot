    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const categorias = ['Alimentação', 'Transporte', 'Lazer', 'Moradia', 'Saúde','Compras','Educação', 'Outros'];\nconst invalido = { descricao: '', valor: 0, categoria: 'Outros', valido: false };\nconst semAcento = (s) => String(s ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();\n\n// 1) lê o JSON que o modelo devolveu\nlet bruto = String($json.text ?? '').replace(/```json|```/gi, '').trim();\nconst ini = bruto.indexOf('{');\nconst fim = bruto.lastIndexOf('}');\n\nlet dados = invalido;\ntry {\n  if (ini !== -1 && fim > ini) dados = JSON.parse(bruto.slice(ini, fim + 1));\n} catch (e) {\n  dados = invalido;\n}\n\n// 2) descrição: usa a grafia que a pessoa digitou\nconst msg = String($('Telegram Trigger').item.json.message.text ?? '');\nlet descricao = String(dados.descricao ?? '').trim();\nconst msgBase = semAcento(msg);\nconst descBase = semAcento(descricao);\nif (descBase && msgBase.length === msg.length) {\n  const pos = msgBase.indexOf(descBase);\n  if (pos !== -1) descricao = msg.slice(pos, pos + descBase.length).trim();\n}\ndescricao = descricao.charAt(0).toUpperCase() + descricao.slice(1);\n\n// 3) categoria: aceita com ou sem acento\nconst categoria = categorias.find((c) => semAcento(c) === semAcento(dados.categoria)) ?? 'Outros';\n\n// 4) valor e validade\nconst valor = Number(dados.valor);\n\nreturn {\n  json: {\n    output: {\n      descricao,\n      valor: Number.isFinite(valor) ? valor : 0,\n      categoria,\n      valido: dados.valido === true,\n    },\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        -16
      ],
      "id": "bd9b612a-ed28-46ee-984d-eac74f567e09",
      "name": "Interpretar resposta"
    }
